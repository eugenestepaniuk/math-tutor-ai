# Server-only configuration. Deterministic checking and tests need no key.
# Keep Groq on the Free plan without adding billing. Confirm the actual account
# tier before enabling it: this flag is an owner assertion, not a billing check.
TUTOR_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FREE_TIER_CONFIRMED=false
TUTOR_ENABLED=false
# Legacy OpenAI is never used as a fallback and is blocked unless explicitly
# selected with TUTOR_PROVIDER=openai and separately allowed here.
TUTOR_ALLOW_PAID=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
